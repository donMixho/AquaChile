# Copia este archivo como ".env" (instalar.bat lo hace solo) y completa los valores.
# Supabase > Project Settings > API.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU-ANON-KEY

# Opcional: crea la carpeta de Drive de cada candidato (Apps Script desplegado con acceso "Cualquier persona").
VITE_GOOGLE_DRIVE_WEBHOOK_URL=
# Opcional: guardar el PDF de la entrevista en Drive. Activar solo con el Apps Script actualizado.
VITE_DRIVE_SUBIR_INFORMES=false
# Opcional: enviar al candidato por correo el informe final. Activar solo con el Apps Script actualizado.
VITE_ENVIAR_INFORME_CORREO=false
